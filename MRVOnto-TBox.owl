<?xml version="1.0" encoding="UTF-8"?>

<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:prov="http://www.w3.org/ns/prov#"
    xmlns:time="http://www.w3.org/2006/time#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:sh="http://www.w3.org/ns/shacl#"
    xmlns:lexid="https://w3id.org/lex-id/schema#"
    xmlns:mrv="http://example.org/mrv#">

    <!-- Ontology Header -->
    <owl:Ontology rdf:about="http://example.org/mrv">
        <dc:title>MRVOnto-Reg v2</dc:title>
        <dc:creator>Your Name</dc:creator>
        <dc:description>
            Ontology for Indonesia's Measurement, Reporting and Verification
            (MRV) process integrated with LexID.
        </dc:description>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <owl:imports rdf:resource="https://w3id.org/lex-id"/>
    </owl:Ontology>

    <!-- Top Level Classes -->
    <owl:Class rdf:about="http://example.org/mrv#Agent">
        <rdfs:label>Agent</rdfs:label>
        <rdfs:comment>A person or organization participating in the MRV lifecycle.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#MRVActivity">
        <rdfs:label>MRV Activity</rdfs:label>
        <rdfs:comment>Activity performed during proposal, validation, verification, monitoring and publication.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Project">
        <rdfs:label>Project</rdfs:label>
        <rdfs:comment>Carbon mitigation or removal project.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Document">
        <rdfs:label>Document</rdfs:label>
        <rdfs:comment>Document generated or consumed by MRV activities.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#CarbonAsset">
        <rdfs:label>Carbon Asset</rdfs:label>
        <rdfs:comment>Digital representation of carbon credits or certificates.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Registry">
        <rdfs:label>Registry</rdfs:label>
        <rdfs:comment>Carbon registry responsible for recording projects and assets.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Methodology">
        <rdfs:label>Methodology</rdfs:label>
        <rdfs:comment>Methodology used for emission reduction calculation.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Evidence">
        <rdfs:label>Evidence</rdfs:label>
        <rdfs:comment>Supporting evidence used during validation and verification.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Location">
        <rdfs:label>Location</rdfs:label>
        <rdfs:comment>Administrative or geographical location.</rdfs:comment>
    </owl:Class>

    <!-- LexID Integration -->
    <owl:Class rdf:about="http://example.org/mrv#LegalResource">
        <rdfs:label>Legal Resource</rdfs:label>
        <rdfs:comment>Indonesian legal resource aligned with LexID.</rdfs:comment>
        <owl:equivalentClass rdf:resource="https://w3id.org/lex-id/schema#LegalResource"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#PresidentialRegulation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Presidential Regulation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#GovernmentRegulation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Government Regulation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#MinisterialRegulation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Ministerial Regulation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#LegalArticle">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Legal Article</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Section">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Section</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#LegalConcept">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Legal Concept</rdfs:label>
    </owl:Class>

    <!-- SubClasses -->
    <owl:Class rdf:about="http://example.org/mrv#Organization">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Person">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Agent"/>
    </owl:Class>

    <!-- Organizations -->
    <owl:Class rdf:about="#ProjectDeveloper">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#ValidationBody">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#VerificationBody">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#GovernmentAgency">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#RegistryOperator">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <!-- Persons -->
    <owl:Class rdf:about="#Reviewer">
        <rdfs:subClassOf rdf:resource="#Person"/>
    </owl:Class>

    <owl:Class rdf:about="#Validator">
        <rdfs:subClassOf rdf:resource="#Person"/>
    </owl:Class>

    <owl:Class rdf:about="#Verifier">
        <rdfs:subClassOf rdf:resource="#Person"/>
    </owl:Class>

    <owl:Class rdf:about="#Publisher">
        <rdfs:subClassOf rdf:resource="#Person"/>
    </owl:Class>

    <!-- MRV Activities -->
    <owl:Class rdf:about="#Proposal">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Validation">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Verification">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Publication">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Monitoring">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Reporting">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <!-- Project Types -->
    <owl:Class rdf:about="#RenewableEnergy">
        <rdfs:subClassOf rdf:resource="#Project"/>
    </owl:Class>

    <owl:Class rdf:about="#FOLU">
        <rdfs:subClassOf rdf:resource="#Project"/>
    </owl:Class>

    <owl:Class rdf:about="#Agriculture">
        <rdfs:subClassOf rdf:resource="#Project"/>
    </owl:Class>

    <owl:Class rdf:about="#WasteManagement">
        <rdfs:subClassOf rdf:resource="#Project"/>
    </owl:Class>

    <owl:Class rdf:about="#Industry">
        <rdfs:subClassOf rdf:resource="#Project"/>
    </owl:Class>

    <owl:Class rdf:about="#Fisheries">
        <rdfs:subClassOf rdf:resource="#Project"/>
    </owl:Class>

    <!-- Documents -->
    <owl:Class rdf:about="#DRAM">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#DRAMFinal">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#LCAM">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#ValidationReport">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#VerificationReport">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#EmissionWorksheet">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#SupportingDocument">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <!-- Carbon Assets -->
    <owl:Class rdf:about="#CarbonCredit">
        <rdfs:subClassOf rdf:resource="#CarbonAsset"/>
    </owl:Class>

    <owl:Class rdf:about="#SPECertificate">
        <rdfs:subClassOf rdf:resource="#CarbonAsset"/>
    </owl:Class>

    <owl:Class rdf:about="#CarbonUnit">
        <rdfs:subClassOf rdf:resource="#CarbonAsset"/>
    </owl:Class>

    <!-- Registries -->
    <owl:Class rdf:about="#SRN">
        <rdfs:subClassOf rdf:resource="#Registry"/>
    </owl:Class>

    <owl:Class rdf:about="#VERRA">
        <rdfs:subClassOf rdf:resource="#Registry"/>
    </owl:Class>

    <owl:Class rdf:about="#GoldStandard">
        <rdfs:subClassOf rdf:resource="#Registry"/>
    </owl:Class>

    <owl:Class rdf:about="#JCM">
        <rdfs:subClassOf rdf:resource="#Registry"/>
    </owl:Class>

    <!-- Location -->
    <owl:Class rdf:about="#Province">
        <rdfs:subClassOf rdf:resource="#Location"/>
    </owl:Class>

    <owl:Class rdf:about="#Regency">
        <rdfs:subClassOf rdf:resource="#Location"/>
    </owl:Class>

    <owl:Class rdf:about="#District">
        <rdfs:subClassOf rdf:resource="#Location"/>
    </owl:Class>

    <owl:Class rdf:about="#Village">
        <rdfs:subClassOf rdf:resource="#Location"/>
    </owl:Class>

    <!-- Methodology -->
    <owl:Class rdf:about="#NationalMethodology">
        <rdfs:subClassOf rdf:resource="#Methodology"/>
    </owl:Class>

    <owl:Class rdf:about="#CDMMethodology">
        <rdfs:subClassOf rdf:resource="#Methodology"/>
    </owl:Class>

    <owl:Class rdf:about="#VERRAMethodology">
        <rdfs:subClassOf rdf:resource="#Methodology"/>
    </owl:Class>

    <!-- Evidence -->
    <owl:Class rdf:about="#MonitoringData">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
    </owl:Class>

    <owl:Class rdf:about="#PhotoEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
    </owl:Class>

    <owl:Class rdf:about="#SatelliteImage">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
    </owl:Class>

    <owl:Class rdf:about="#MeasurementRecord">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
    </owl:Class>

    <!-- Core ObjectProperties -->
    <owl:ObjectProperty rdf:about="#submittedBy">
        <rdfs:domain rdf:resource="#Proposal"/>
        <rdfs:range rdf:resource="#ProjectDeveloper"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#reviewedBy">
        <rdfs:domain rdf:resource="#Proposal"/>
        <rdfs:range rdf:resource="#Reviewer"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#validatedBy">
        <rdfs:domain rdf:resource="#Validation"/>
        <rdfs:range rdf:resource="#Validator"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#verifiedBy">
        <rdfs:domain rdf:resource="#Verification"/>
        <rdfs:range rdf:resource="#Verifier"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasDocument">
        <rdfs:domain rdf:resource="#MRVActivity"/>
        <rdfs:range rdf:resource="#Document"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usesMethodology">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Methodology"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasEvidence">
        <rdfs:domain rdf:resource="#Verification"/>
        <rdfs:range rdf:resource="#Evidence"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#generatesReport">
        <rdfs:domain rdf:resource="#MRVActivity"/>
        <rdfs:range rdf:resource="#Document"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#issuesCertificate">
        <rdfs:domain rdf:resource="#Publication"/>
        <rdfs:range rdf:resource="#SPECertificate"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasCarbonCredit">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#CarbonCredit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#locatedIn">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#registeredIn">
        <rdfs:domain rdf:resource="#CarbonAsset"/>
        <rdfs:range rdf:resource="#Registry"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#governedBy">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#LegalResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#regulatedBy">
        <rdfs:domain rdf:resource="#MRVActivity"/>
        <rdfs:range rdf:resource="#LegalArticle"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasLegalBasis">
        <rdfs:domain rdf:resource="#Document"/>
        <rdfs:range rdf:resource="#LegalArticle"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#carbonCreditOf">
        <rdfs:domain rdf:resource="#CarbonCredit"/>
        <rdfs:range rdf:resource="#Project"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#referencesLaw">
        <rdfs:domain rdf:resource="#Registry"/>
        <rdfs:range rdf:resource="#LegalResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#basedOn">
        <rdfs:label xml:lang="en">based on</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInformedBy"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#issuedUnder">
        <rdfs:label xml:lang="en">issued under</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://example.org/mrv#governedBy"/>
    </owl:ObjectProperty>

    <!-- Datatype Properties -->
    <owl:DatatypeProperty rdf:about="#projectID">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectName">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectDescription">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectStatus">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectArea">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#documentNumber">
        <rdfs:domain rdf:resource="#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#documentTitle">
        <rdfs:domain rdf:resource="#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#documentVersion">
        <rdfs:domain rdf:resource="#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#documentDate">
        <rdfs:domain rdf:resource="#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#documentStatus">
        <rdfs:domain rdf:resource="#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#activityID">
        <rdfs:domain rdf:resource="#MRVActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#activityDate">
        <rdfs:domain rdf:resource="#MRVActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#activityStatus">
        <rdfs:domain rdf:resource="#MRVActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#certificateNumber">
        <rdfs:domain rdf:resource="#SPECertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#issueDate">
        <rdfs:domain rdf:resource="#CarbonAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#expiryDate">
        <rdfs:domain rdf:resource="#CarbonAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#carbonAmount">
        <rdfs:domain rdf:resource="#CarbonCredit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#serialNumber">
        <rdfs:domain rdf:resource="#CarbonCredit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#registryID">
        <rdfs:domain rdf:resource="#Registry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#registryName">
        <rdfs:domain rdf:resource="#Registry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#methodologyCode">
        <rdfs:domain rdf:resource="#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#methodologyVersion">
        <rdfs:domain rdf:resource="#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#approvalDate">
        <rdfs:domain rdf:resource="#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#evidenceType">
        <rdfs:domain rdf:resource="#Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#evidenceFile">
        <rdfs:domain rdf:resource="#Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#captureDate">
        <rdfs:domain rdf:resource="#Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#provinceName">
        <rdfs:domain rdf:resource="#Province"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#regencyName">
        <rdfs:label xml:lang="en">regency name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/mrv#Regency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#originStandard">
        <rdfs:label xml:lang="en">origin standard</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonCredit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#methodologyName">
        <rdfs:label xml:lang="en">methodology name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/mrv#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#latitude">
        <rdfs:domain rdf:resource="#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#longitude">
        <rdfs:domain rdf:resource="#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#regulationNumber">
        <rdfs:domain rdf:resource="#LegalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#enactmentDate">
        <rdfs:domain rdf:resource="#LegalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty> 

    <!-- Class Restrictions -->
    <owl:Class rdf:about="#Proposal">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#submittedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#ProjectDeveloper"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Validation">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#validatedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Validator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Verification">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#verifiedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Verifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasEvidence"/>
                <owl:someValuesFrom rdf:resource="#Evidence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Publication">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#issuesCertificate"/>
                <owl:someValuesFrom rdf:resource="#SPECertificate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Project">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#usesMethodology"/>
                <owl:someValuesFrom rdf:resource="#Methodology"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasDocument"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="#Document"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#locatedIn"/>
                <owl:someValuesFrom rdf:resource="#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#CarbonCredit">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#carbonCreditOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#CarbonAsset">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#registeredIn"/>
                <owl:someValuesFrom rdf:resource="#Registry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#MRVActivity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#regulatedBy"/>
                <owl:someValuesFrom rdf:resource="#LegalArticle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Document">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasLegalBasis"/>
                <owl:someValuesFrom rdf:resource="#LegalArticle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Registry">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#referencesLaw"/>
                <owl:someValuesFrom rdf:resource="#LegalResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- SHACL Shapes -->
    <sh:NodeShape rdf:about="#ProposalShape">
        <sh:targetClass rdf:resource="#Proposal"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#submittedBy"/>
                <sh:class rdf:resource="#ProjectDeveloper"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#hasDocument"/>
                <sh:class rdf:resource="#Document"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <!-- Final DRAM must be basedOn a DRAM -->
    <sh:NodeShape rdf:about="http://example.org/mrv#DRAMFinalShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#DRAMFinal"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#basedOn"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:class rdf:resource="http://example.org/mrv#DRAM"/>
                <sh:message xml:lang="en">Final DRAM must be basedOn at least one DRAM instance.</sh:message>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#ValidationShape">
        <sh:targetClass rdf:resource="#Validation"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#validatedBy"/>
                <sh:class rdf:resource="#Validator"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#generatesReport"/>
                <sh:class rdf:resource="#ValidationReport"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#VerificationShape">
        <sh:targetClass rdf:resource="#Verification"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#verifiedBy"/>
                <sh:class rdf:resource="#Verifier"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#hasEvidence"/>
                <sh:class rdf:resource="#Evidence"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <!-- LCAM must be basedOn a FinalDRAM -->
    <sh:NodeShape rdf:about="http://example.org/mrv#LCAMShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#LCAM"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#basedOn"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:class rdf:resource="http://example.org/mrv#DRAMFinal"/>
                <sh:message xml:lang="en">LCAM must be basedOn at least one FinalDRAM instance.</sh:message>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <!--  VerificationReport must be basedOn an LCAM -->
    <sh:NodeShape rdf:about="http://example.org/mrv#VerificationReportShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#VerificationReport"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#basedOn"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:class rdf:resource="http://example.org/mrv#LCAM"/>
                <sh:message xml:lang="en">VerificationReport must be basedOn at least one LCAM instance.</sh:message>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#PublicationShape">
        <sh:targetClass rdf:resource="#Publication"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#issuesCertificate"/>
                <sh:class rdf:resource="#SPECertificate"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#ProjectShape">
        <sh:targetClass rdf:resource="#Project"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#usesMethodology"/>
                <sh:class rdf:resource="#Methodology"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#locatedIn"/>
                <sh:class rdf:resource="#Location"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#CarbonCreditShape">
        <sh:targetClass rdf:resource="#CarbonCredit"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#registeredIn"/>
                <sh:class rdf:resource="#Registry"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#RegistryShape">
        <sh:targetClass rdf:resource="#Registry"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#referencesLaw"/>
                <sh:class rdf:resource="#LegalResource"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#DocumentShape">
        <sh:targetClass rdf:resource="#Document"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#hasLegalBasis"/>
                <sh:class rdf:resource="#LegalArticle"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:PropertyShape rdf:about="#ProjectNameShape">
        <sh:path rdf:resource="#projectName"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    </sh:PropertyShape>

</rdf:RDF>