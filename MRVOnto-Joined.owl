    <owl:DatatypeProperty rdf:about="http://example.org/mrv#registryID">
        <rdfs:domain rdf:resource="http://example.org/mrv#Registry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#registryName">
        <rdfs:domain rdf:resource="http://example.org/mrv#Registry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#methodologyCode">
        <rdfs:domain rdf:resource="http://example.org/mrv#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#methodologyVersion">
        <rdfs:domain rdf:resource="http://example.org/mrv#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
