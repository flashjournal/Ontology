    <owl:DatatypeProperty rdf:about="http://example.org/mrv#approvalDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#evidenceType">
        <rdfs:domain rdf:resource="http://example.org/mrv#Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
