<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://example.org/mrv#"
    xmlns:mrv="http://example.org/mrv#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:prov="http://www.w3.org/ns/prov#"
    xmlns:time="http://www.w3.org/2006/time#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:sh="http://www.w3.org/ns/shacl#"
    xmlns:lexid="https://w3id.org/lex-id/schema#">

    <!-- Ontology Header -->
    <owl:Ontology rdf:about="http://example.org/mrv">
        <dc:title>MRVOnto-Reg v2 (Unified Schema &amp; Instances)</dc:title>
        <dc:creator>Unified Ontology</dc:creator>
        <dc:description>
            Combined ontology containing schema definition and instance data for Indonesia's 
            Measurement, Reporting, and Verification (MRV) process integrated with LexID.
        </dc:description>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <owl:imports rdf:resource="https://w3id.org/lex-id"/>
    </owl:Ontology>

    <!-- ================================================================= -->
    <!-- SCHEMA: CLASSES                                                  -->
    <!-- ================================================================= -->

    <!-- Top Level Classes -->
    <owl:Class rdf:about="http://example.org/mrv#Agent">
        <rdfs:label>Agent</rdfs:label>
        <rdfs:comment>A person or organization participating in the MRV lifecycle.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#MRVActivity">
        <rdfs:label>MRV Activity</rdfs:label>
        <rdfs:comment>Activity performed during proposal, validation, verification, monitoring and publication.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Project">
        <rdfs:label>Project</rdfs:label>
        <rdfs:comment>Carbon mitigation or removal project.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Document">
        <rdfs:label>Document</rdfs:label>
        <rdfs:comment>Document generated or consumed by MRV activities.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#CarbonAsset">
        <rdfs:label>Carbon Asset</rdfs:label>
        <rdfs:comment>Digital representation of carbon credits or certificates.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Registry">
        <rdfs:label>Registry</rdfs:label>
        <rdfs:comment>Carbon registry responsible for recording projects and assets.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Methodology">
        <rdfs:label>Methodology</rdfs:label>
        <rdfs:comment>Methodology used for emission reduction calculation.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Evidence">
        <rdfs:label>Evidence</rdfs:label>
        <rdfs:comment>Supporting evidence used during validation and verification.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Location">
        <rdfs:label>Location</rdfs:label>
        <rdfs:comment>Administrative or geographical location.</rdfs:comment>
    </owl:Class>

    <!-- LexID Integration -->
    <owl:Class rdf:about="http://example.org/mrv#LegalResource">
        <rdfs:label>Legal Resource</rdfs:label>
        <rdfs:comment>Indonesian legal resource aligned with LexID.</rdfs:comment>
        <owl:equivalentClass rdf:resource="https://w3id.org/lex-id/schema#LegalResource"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#PresidentialRegulation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Presidential Regulation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#GovernmentRegulation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Government Regulation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#MinisterialRegulation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Ministerial Regulation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#LegalArticle">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Legal Article</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Section">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Section</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#LegalConcept">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:label>Legal Concept</rdfs:label>
    </owl:Class>

    <!-- SubClasses -->
    <owl:Class rdf:about="http://example.org/mrv#Organization">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Person">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Agent"/>
    </owl:Class>

    <!-- Organizations -->
    <owl:Class rdf:about="http://example.org/mrv#ProjectDeveloper">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#ValidationBody">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#VerificationBody">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#GovernmentAgency">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#RegistryOperator">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Organization"/>
    </owl:Class>

    <!-- Persons -->
    <owl:Class rdf:about="http://example.org/mrv#Reviewer">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Validator">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Verifier">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Publisher">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Person"/>
    </owl:Class>

    <!-- MRV Activities -->
    <owl:Class rdf:about="http://example.org/mrv#Proposal">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Validation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Verification">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Publication">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Monitoring">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Reporting">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
    </owl:Class>

    <!-- Project Types -->
    <owl:Class rdf:about="http://example.org/mrv#RenewableEnergy">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Project"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#FOLU">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Project"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Agriculture">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Project"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#WasteManagement">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Project"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Industry">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Project"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Fisheries">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Project"/>
    </owl:Class>

    <!-- Documents -->
    <owl:Class rdf:about="http://example.org/mrv#DRAM">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#DRAMFinal">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#LCAM">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#ValidationReport">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#VerificationReport">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#EmissionWorksheet">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#SupportingDocument">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Document"/>
    </owl:Class>

    <!-- Carbon Assets -->
    <owl:Class rdf:about="http://example.org/mrv#CarbonCredit">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#CarbonAsset"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#SPECertificate">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#CarbonAsset"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#CarbonUnit">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#CarbonAsset"/>
    </owl:Class>

    <!-- Registries -->
    <owl:Class rdf:about="http://example.org/mrv#SRN">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Registry"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#VERRA">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Registry"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#GoldStandard">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Registry"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#JCM">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Registry"/>
    </owl:Class>

    <!-- Location -->
    <owl:Class rdf:about="http://example.org/mrv#Province">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Location"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Regency">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Location"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#District">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Location"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Village">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Location"/>
    </owl:Class>

    <!-- Methodology -->
    <owl:Class rdf:about="http://example.org/mrv#NationalMethodology">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Methodology"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#CDMMethodology">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Methodology"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#VERRAMethodology">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Methodology"/>
    </owl:Class>

    <!-- Evidence -->
    <owl:Class rdf:about="http://example.org/mrv#MonitoringData">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Evidence"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#PhotoEvidence">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Evidence"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#SatelliteImage">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Evidence"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#MeasurementRecord">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#Evidence"/>
    </owl:Class>

    <!-- ================================================================= -->
    <!-- SCHEMA: PROPERTIES                                               -->
    <!-- ================================================================= -->

    <!-- Core ObjectProperties -->
    <owl:ObjectProperty rdf:about="http://example.org/mrv#submittedBy">
        <rdfs:domain rdf:resource="http://example.org/mrv#Proposal"/>
        <rdfs:range rdf:resource="http://example.org/mrv#ProjectDeveloper"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#reviewedBy">
        <rdfs:domain rdf:resource="http://example.org/mrv#Proposal"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Reviewer"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#validatedBy">
        <rdfs:domain rdf:resource="http://example.org/mrv#Validation"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Validator"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#verifiedBy">
        <rdfs:domain rdf:resource="http://example.org/mrv#Verification"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Verifier"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#hasDocument">
        <rdfs:domain rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Document"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#usesMethodology">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Methodology"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#hasEvidence">
        <rdfs:domain rdf:resource="http://example.org/mrv#Verification"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Evidence"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#generatesReport">
        <rdfs:domain rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Document"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#issuesCertificate">
        <rdfs:domain rdf:resource="http://example.org/mrv#Publication"/>
        <rdfs:range rdf:resource="http://example.org/mrv#SPECertificate"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#hasCarbonCredit">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://example.org/mrv#CarbonCredit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#locatedIn">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#registeredIn">
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonAsset"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Registry"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#governedBy">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://example.org/mrv#LegalResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#regulatedBy">
        <rdfs:domain rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:range rdf:resource="http://example.org/mrv#LegalArticle"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#hasLegalBasis">
        <rdfs:domain rdf:resource="http://example.org/mrv#Document"/>
        <rdfs:range rdf:resource="http://example.org/mrv#LegalArticle"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#carbonCreditOf">
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonCredit"/>
        <rdfs:range rdf:resource="http://example.org/mrv#Project"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#referencesLaw">
        <rdfs:domain rdf:resource="http://example.org/mrv#Registry"/>
        <rdfs:range rdf:resource="http://example.org/mrv#LegalResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#basedOn">
        <rdfs:label xml:lang="en">based on</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInformedBy"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/mrv#issuedUnder">
        <rdfs:label xml:lang="en">issued under</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://example.org/mrv#governedBy"/>
    </owl:ObjectProperty>

    <!-- Datatype Properties -->
    <owl:DatatypeProperty rdf:about="http://example.org/mrv#projectID">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#projectName">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#projectDescription">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#projectStatus">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#projectArea">
        <rdfs:domain rdf:resource="http://example.org/mrv#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#documentNumber">
        <rdfs:domain rdf:resource="http://example.org/mrv#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#documentTitle">
        <rdfs:domain rdf:resource="http://example.org/mrv#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#documentVersion">
        <rdfs:domain rdf:resource="http://example.org/mrv#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#documentDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#documentStatus">
        <rdfs:domain rdf:resource="http://example.org/mrv#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#activityID">
        <rdfs:domain rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#activityDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#activityStatus">
        <rdfs:domain rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#certificateNumber">
        <rdfs:domain rdf:resource="http://example.org/mrv#SPECertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#issueDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#expiryDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#carbonAmount">
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonCredit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#serialNumber">
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonCredit"/>
