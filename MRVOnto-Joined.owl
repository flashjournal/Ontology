    <owl:DatatypeProperty rdf:about="http://example.org/mrv#evidenceFile">
        <rdfs:domain rdf:resource="http://example.org/mrv#Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#captureDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#provinceName">
        <rdfs:domain rdf:resource="http://example.org/mrv#Province"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#regencyName">
        <rdfs:label xml:lang="en">regency name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/mrv#Regency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#originStandard">
        <rdfs:label xml:lang="en">origin standard</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/mrv#CarbonCredit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#methodologyName">
        <rdfs:label xml:lang="en">methodology name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/mrv#Methodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#latitude">
        <rdfs:domain rdf:resource="http://example.org/mrv#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#longitude">
        <rdfs:domain rdf:resource="http://example.org/mrv#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#regulationNumber">
        <rdfs:domain rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/mrv#enactmentDate">
        <rdfs:domain rdf:resource="http://example.org/mrv#LegalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty> 

    <!-- Class Restrictions -->
    <owl:Class rdf:about="http://example.org/mrv#Proposal">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#submittedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/mrv#ProjectDeveloper"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Validation">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#validatedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/mrv#Validator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Verification">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#verifiedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/mrv#Verifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#hasEvidence"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#Evidence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Publication">
        <rdfs:subClassOf rdf:resource="http://example.org/mrv#MRVActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#issuesCertificate"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#SPECertificate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Project">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#usesMethodology"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#Methodology"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#hasDocument"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/mrv#Document"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#locatedIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#CarbonCredit">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#carbonCreditOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/mrv#Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#CarbonAsset">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#registeredIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#Registry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#MRVActivity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#regulatedBy"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#LegalArticle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Document">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#hasLegalBasis"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#LegalArticle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/mrv#Registry">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/mrv#referencesLaw"/>
                <owl:someValuesFrom rdf:resource="http://example.org/mrv#LegalResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- SHACL Shapes -->
    <sh:NodeShape rdf:about="http://example.org/mrv#ProposalShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Proposal"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#submittedBy"/>
                <sh:class rdf:resource="http://example.org/mrv#ProjectDeveloper"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#hasDocument"/>
                <sh:class rdf:resource="http://example.org/mrv#Document"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#DRAMFinalShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#DRAMFinal"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#basedOn"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:class rdf:resource="http://example.org/mrv#DRAM"/>
                <sh:message xml:lang="en">Final DRAM must be basedOn at least one DRAM instance.</sh:message>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#ValidationShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Validation"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#validatedBy"/>
                <sh:class rdf:resource="http://example.org/mrv#Validator"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#generatesReport"/>
                <sh:class rdf:resource="http://example.org/mrv#ValidationReport"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#VerificationShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Verification"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#verifiedBy"/>
                <sh:class rdf:resource="http://example.org/mrv#Verifier"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#hasEvidence"/>
                <sh:class rdf:resource="http://example.org/mrv#Evidence"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#LCAMShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#LCAM"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#basedOn"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:class rdf:resource="http://example.org/mrv#DRAMFinal"/>
                <sh:message xml:lang="en">LCAM must be basedOn at least one FinalDRAM instance.</sh:message>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#VerificationReportShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#VerificationReport"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#basedOn"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:class rdf:resource="http://example.org/mrv#LCAM"/>
                <sh:message xml:lang="en">VerificationReport must be basedOn at least one LCAM instance.</sh:message>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#PublicationShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Publication"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#issuesCertificate"/>
                <sh:class rdf:resource="http://example.org/mrv#SPECertificate"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#ProjectShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Project"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#usesMethodology"/>
                <sh:class rdf:resource="http://example.org/mrv#Methodology"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#locatedIn"/>
                <sh:class rdf:resource="http://example.org/mrv#Location"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#CarbonCreditShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#CarbonCredit"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#registeredIn"/>
                <sh:class rdf:resource="http://example.org/mrv#Registry"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#RegistryShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Registry"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#referencesLaw"/>
                <sh:class rdf:resource="http://example.org/mrv#LegalResource"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="http://example.org/mrv#DocumentShape">
        <sh:targetClass rdf:resource="http://example.org/mrv#Document"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="http://example.org/mrv#hasLegalBasis"/>
                <sh:class rdf:resource="http://example.org/mrv#LegalArticle"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:PropertyShape rdf:about="http://example.org/mrv#ProjectNameShape">
        <sh:path rdf:resource="http://example.org/mrv#projectName"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    </sh:PropertyShape>

    <!-- ================================================================= -->
    <!-- INSTANCES & INDIVIDUALS                                          -->
    <!-- ================================================================= -->

    <!-- Shared Registries & Legal Basis -->
    <owl:NamedIndividual rdf:about="http://example.org/mrv#SRNIndonesia">
        <rdf:type rdf:resource="http://example.org/mrv#SRN"/>
        <registryName>SRN Indonesia</registryName>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#SPEI">
        <rdf:type rdf:resource="http://example.org/mrv#Registry"/>
        <registryID>SPEI</registryID>
        <registryName>Sistem Pengendalian Emisi Indonesia</registryName>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#Perpres1102025">
        <rdf:type rdf:resource="http://example.org/mrv#PresidentialRegulation"/>
        <regulationNumber>110/2025</regulationNumber>
    </owl:NamedIndividual>

    <!-- Shared Methodologies -->
    <owl:NamedIndividual rdf:about="http://example.org/mrv#VM0015">
        <rdf:type rdf:resource="http://example.org/mrv#VERRAMethodology"/>
        <methodologyCode>VM0015</methodologyCode>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#AM001">
        <rdf:type rdf:resource="http://example.org/mrv#NationalMethodology"/>
        <methodologyCode>AM001</methodologyCode>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#NationalMethodology001">
        <rdf:type rdf:resource="http://example.org/mrv#NationalMethodology"/>
        <methodologyCode>SPEI-ENERGI-001</methodologyCode>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#GoldStandardMethodology">
        <rdf:type rdf:resource="http://example.org/mrv#Methodology"/>
        <methodologyCode>GS-RE-001</methodologyCode>
        <methodologyName>Gold Standard Renewable Energy Methodology</methodologyName>
    </owl:NamedIndividual>

    <!-- Instance 1: Nagata Biogas Project -->
    <owl:NamedIndividual rdf:about="http://example.org/mrv#PTNagataBioEnergi">
        <rdf:type rdf:resource="http://example.org/mrv#ProjectDeveloper"/>
        <rdfs:label>PT Nagata Bio Energi</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#WestJava">
        <rdf:type rdf:resource="http://example.org/mrv#Province"/>
        <provinceName>West Java</provinceName>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#Bogor">
        <rdf:type rdf:resource="http://example.org/mrv#Regency"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#Sukamakmur">
        <rdf:type rdf:resource="http://example.org/mrv#District"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#Project_Nagata_Biogas">
        <rdf:type rdf:resource="http://example.org/mrv#RenewableEnergy"/>
        <rdf:type rdf:resource="http://example.org/mrv#WasteManagement"/>
        <projectID>PRJ-2023-10134</projectID>
        <projectName>Pembangkit Listrik Tenaga Biogas Sukadamai 2.4 MW dari Recovery Biogas pada Pengolahan Limbah POME</projectName>
        <projectStatus>Published</projectStatus>
        <locatedIn rdf:resource="http://example.org/mrv#Sukamakmur"/>
        <usesMethodology rdf:resource="http://example.org/mrv#NationalMethodology001"/>
        <governedBy rdf:resource="http://example.org/mrv#Perpres1102025"/>
        <hasCarbonCredit rdf:resource="http://example.org/mrv#CarbonCredit_Nagata"/>
        <hasDocument rdf:resource="http://example.org/mrv#DRAM_Nagata"/>
        <hasDocument rdf:resource="http://example.org/mrv#DRAMFinal_Nagata"/>
        <hasDocument rdf:resource="http://example.org/mrv#LCAM_Nagata"/>
        <hasDocument rdf:resource="http://example.org/mrv#ValidationReport_Nagata"/>
        <hasDocument rdf:resource="http://example.org/mrv#VerificationReport_Nagata"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#Proposal_Nagata">
        <submittedBy rdf:resource="http://example.org/mrv#PTNagataBioEnergi"/>
        <hasDocument rdf:resource="http://example.org/mrv#DRAM_Nagata"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#DRAM_Nagata">
        <rdf:type rdf:resource="http://example.org/mrv#DRAM"/>
        <rdfs:label>DRAM Nagata</rdfs:label>
        <basedOn rdf:resource="http://example.org/mrv#Proposal_Nagata"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#DRAMFinal_Nagata">
        <rdf:type rdf:resource="http://example.org/mrv#DRAMFinal"/>
        <documentStatus>Approved</documentStatus>
        <basedOn rdf:resource="http://example.org/mrv#DRAM_Nagata"/>
        <basedOn rdf:resource="http://example.org/mrv#ValidationReport_Nagata"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#LCAM_Nagata">
        <rdf:type rdf:resource="http://example.org/mrv#LCAM"/>
        <documentNumber>LCAM-2025-001</documentNumber>
        <documentStatus>Submitted</documentStatus>
        <basedOn rdf:resource="http://example.org/mrv#DRAMFinal_Nagata"/>
        <hasEvidence rdf:resource="http://example.org/mrv#MonitoringData_Nagata"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/mrv#Validator01">
        <rdf:type rdf:resource="http://example.org/mrv#Validator"/>
        <rdfs:label>Validator01</rdfs:label>
    </owl:NamedIndividual>

